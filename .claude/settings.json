{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch/ticket policy"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(make test-unit)",
      "Bash(make test-integration)",
      "Bash(make all)",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__get_project",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_issue_labels"
    ]
  }
}
